generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Marka (bulut mutfak: her markanın kendi menüsü, Meta kataloğu ve WhatsApp numarası var)
model Brand {
  id            Int        @id @default(autoincrement())
  code          String     @unique // kısa kod: "tandir", "pide" (env'de META_ACCESS_TOKEN_<KOD> için de kullanılır)
  name          String
  sortOrder     Int        @default(0)
  // Meta katalog kimliği; markanın Meta ayarları hazır olana kadar boş kalabilir
  metaCatalogId String?
  // WAHA oturum adı (Aşama 4)
  waSession     String?
  // Resmi WhatsApp Cloud API telefon numarası kimliği (Meta); webhook olayları bu kimlikle markaya eşlenir
  waPhoneNumberId String?
  categories    Category[]
  products      Product[]
  orders        Order[]
}

model Category {
  id        Int       @id @default(autoincrement())
  brandId   Int       @default(1)
  brand     Brand     @relation(fields: [brandId], references: [id])
  name      String
  sortOrder Int       @default(0)
  // Meta'daki koleksiyon (ürün seti) kimliği ve en son gönderilen içerik imzası (sıra + ürünler)
  metaSetId  String?
  metaSetSig String?
  products  Product[]

  @@unique([brandId, name])
}

model Product {
  id          Int      @id @default(autoincrement())
  brandId     Int      @default(1)
  brand       Brand    @relation(fields: [brandId], references: [id])
  // Meta kataloğundaki retailer_id; oluşturulduktan sonra DEĞİŞMEZ. Marka içinde benzersiz.
  retailerId  String
  // Ürünün temel adı. Porsiyon seçenekleri (varyant) aynı ada ve aynı groupKey'e sahip ayrı kayıtlardır.
  name        String
  // Aynı yemeğin porsiyonlarını birleştirir (örn. POS kodu); porsiyonu olmayan üründe boş
  groupKey    String?
  // "Yarım", "1,5 Pors.", "500 gr"... Boşsa tek porsiyonlu ürün
  variantLabel String?
  description String   @default("")
  // Liste fiyatı (kuruş). Nakit/kart indirimi sipariş anında uygulanır, burada tutulmaz.
  priceKurus  Int
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  imagePath   String?
  // ACTIVE | PASSIVE (PASSIVE: katalogda hiç görünmez)
  status      String   @default("ACTIVE")
  // Bu ana kadar "bugün tükendi" (sonraki sabah otomatik açılır)
  soldOutUntil DateTime?
  sortOrder   Int      @default(0)
  // Meta eşitleme durumu (Aşama 2b'de kullanılacak)
  metaId        String?
  // Ürün şu an Meta kataloğunda mı (silme/oluşturma kararı için)
  onMeta        Boolean  @default(false)
  metaSyncState String   @default("PENDING") // PENDING | SYNCED | ERROR
  metaError     String?
  metaSyncedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([brandId, retailerId])
  @@index([categoryId])
  @@index([brandId, groupKey])
}

// WAHA'dan gelen ham olaylar (mesajlar, oturum durumu). İçerikte müşteri telefon numarası ve mesaj metni bulunur:
// KVKK gereği düzenli silinir (sunucu 14 günden eski olayları temizler).
model WebhookEvent {
  id          Int      @id @default(autoincrement())
  receivedAt  DateTime @default(now())
  // WAHA'nın istek kimliği: yeniden denemelerde aynı olay iki kez kaydedilmesin
  requestId   String?  @unique
  session     String
  event       String
  // Mesaj olaylarında WhatsApp mesaj türü (chat, order, product...); diğerlerinde boş
  messageType String?
  body        String

  @@index([receivedAt])
  @@index([session, event])
}

// Ayar anahtar/değer deposu (mesaj şablonları vb. ileride burada tutulacak).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Müşteri: WhatsApp numarası (wa_id) ve Meta'nın kullanıcı kimliği (BSUID). Kullanıcı adı özelliği açık müşterilerde telefon gelmeyebilir.
model Customer {
  id        Int      @id @default(autoincrement())
  waId      String?  @unique
  bsuid     String?  @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

// Sipariş: WhatsApp katalog sepetinden gelir. Fiyatlar müşterinin sepette gördüğü liste fiyatlarıdır.
model Order {
  id          Int         @id @default(autoincrement())
  brandId     Int
  brand       Brand       @relation(fields: [brandId], references: [id])
  customerId  Int
  customer    Customer    @relation(fields: [customerId], references: [id])
  // Meta mesaj kimliği: aynı sipariş webhook'u tekrar gelirse ikinci kayıt açılmaz
  waMessageId String      @unique
  // NEW | PREPARING | ON_THE_WAY | DELIVERED | CANCELLED
  status      String      @default("NEW")
  note        String      @default("")
  totalKurus  Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  items       OrderItem[]

  @@index([brandId, status])
  @@index([createdAt])
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Ürün sonradan silinse de sipariş okunabilsin: ad ve fiyat sipariş anındaki halidir
  productId  Int?
  retailerId String
  name       String
  unitKurus  Int
  quantity   Int
}
