# Bu dosya şablondur. Gerçek değerleri .env dosyasına yazın (.env git'e girmez).
# Yönetici şifresi ve oturum anahtarı için: npm run admin:password

# Uygulama
NODE_ENV=development
PORT=3000
# Üretimde kalıcı volume içinde olmalı, örn. file:/data/tndrwa.db
DATABASE_URL=file:./dev.db

# Görseller: Meta'nın çekeceği herkese açık HTTPS adres ve kalıcı klasör (üretimde /data/uploads)
PUBLIC_BASE_URL=https://tndrwa.derinsoft.com.tr
UPLOAD_DIR=./uploads

# Giriş (şifrenin kendisi saklanmaz, yalnızca hash'i)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# En az 32 karakter rastgele (npm run admin:password üretir)
SESSION_SECRET=

# Meta Graph API sürümü (güncel sürümü resmi dokümandan doğrulayın)
META_GRAPH_VERSION=v23.0

# Katalog ID (gizli değil)
META_CATALOG_ID=1868568421015157

# true: panel değişiklikleri otomatik Meta'ya gider (önce elle deneyin)
META_AUTO_SYNC=false

# Sistem kullanıcısı jetonu (GİZLİ: sadece .env veya Coolify ortam değişkeni)
META_ACCESS_TOKEN=

# Yalnızca yerel deploy betikleri için (üretim ortamında gerekmez)
COOLIFY_URL=
COOLIFY_TOKEN=

# Suitable Dış Kaynak API (POS'a sipariş yazma, durum izleme). Taban adres ve anahtar birlikte verilir; hiçbiri yoksa siparişler eklentiyle yazılır.
# Yazma yöntemi panelde POS sayfasından seçilir (API / eklenti).
# SUITABLE_API_BASE=https://api-suitable-live.web.app/v1
# SUITABLE_API_KEY=swk_...
# Webhook imza gizlisi (whsec_...); Suitable bu adrese POST atar: <PUBLIC_BASE_URL>/api/webhooks/suitable
# SUITABLE_WEBHOOK_SECRET=whsec_...
# Marka başına işletme (store) kimliği; verilmezse markanın POS şube kimliği kullanılır
# SUITABLE_STORE_PIDE=IgQbfHON67KGWquAR56g
# SUITABLE_STORE_TANDIR=ha2IkToBZD0wKj1xGLYK
# Fiyat modu (anahtar POS'ta üretilirken seçilen modla aynı olmalı): auto (Suitable fiyatı ve kampanyayı hesaplar, önerilen) | server | platform
# SUITABLE_PRICE_MODE=auto
# Not: anahtar, adres ve fiyat modu istenirse env yerine panelden (POS sayfası > Suitable bağlantısı) girilebilir; webhook da panelden kurulur.
